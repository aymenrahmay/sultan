<odoo>
    <record id="product_template_form_vehicle_after_sales" model="ir.ui.view">
        <field name="name">product.template.form.vehicle.after.sales</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Vehicle After-Sales" name="vehicle_after_sales_group">
                    <field name="is_vehicle_after_sales"/>
                    <field name="vehicle_warranty_months" invisible="not is_vehicle_after_sales"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
